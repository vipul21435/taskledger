# Copy to .env and adjust. Every variable is optional; defaults are shown.
# TASKLEDGER_DATABASE_URL and TASKLEDGER_HOME are read by `taskledger cache` and
# `taskledger ledger`; the lock TTL and near-duplicate threshold are reserved
# for later slices (see PLAN.md).

# SQLAlchemy URL of the shared ledger. SQLite by default, Postgres in docker-compose:
#   postgresql+psycopg://taskledger:taskledger@localhost:5432/taskledger
TASKLEDGER_DATABASE_URL=sqlite:///./.taskledger/ledger.db

# Directory for the ledger database (default URL), the dedupe cache (<home>/cache)
# and, later, the build cache and file locks.
TASKLEDGER_HOME=./.taskledger

# Default lease TTL (seconds) for DB-backed build locks.
TASKLEDGER_LOCK_TTL_SECONDS=900

# Near-duplicate threshold (estimated Jaccard similarity, 0..1).
TASKLEDGER_NEAR_DUP_THRESHOLD=0.8
